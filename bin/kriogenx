#!/usr/bin/env bash
#
# kriogenx — developer environment toolkit
#
# Layout:
#   bin/              commands on your PATH (this file is the entry point)
#   lib/kriogenx/     the code behind each kriogenx subcommand
#   libexec/install/  installers run through `kriogenx install <what>`

# Repo root = parent of this script's real location (follows symlinks)
_krio_self="${BASH_SOURCE[0]}"
while [[ -L $_krio_self ]]; do
  _krio_link=$(readlink "$_krio_self")
  [[ $_krio_link == /* ]] || _krio_link="$(dirname "$_krio_self")/$_krio_link"
  _krio_self=$_krio_link
done
KRIO_ROOT="$(cd "$(dirname "$_krio_self")/.." && pwd)"
unset _krio_self _krio_link

KRIO_DIR="${KRIO_DIR:-$KRIO_ROOT}"   # checkout that version/release/update act on
KRIO_BIN="$KRIO_ROOT/bin"
# shellcheck disable=SC2034 # used by lib/kriogenx/install.sh
KRIO_LIBEXEC="$KRIO_ROOT/libexec"

for _krio_lib in common services install version update help; do
  # shellcheck source=/dev/null
  source "$KRIO_ROOT/lib/kriogenx/$_krio_lib.sh"
done
unset _krio_lib

COMMAND="${1:-help}"
shift

case "$COMMAND" in
  # Services
  n|ng|nginx)          _nginx "$@" ;;
  p|pg|postgres)       _postgres "$@" ;;
  r|redis)             _redis "$@" ;;

  # Install
  i|install)           _install "$@" ;;
  developer-essentials|dev-essentials|dev)
    _install essentials
    ;;
  ruby|node|python|rust|go|docker)
    _install "$COMMAND" "$@"
    ;;

  # Setup
  pimp-my-shell|shell)     exec "$KRIO_BIN/pimp-my-shell" "$@" ;;
  pimp-my-git|git)         exec "$KRIO_BIN/pimp-my-git" "$@" ;;
  profile-scripts|profile) exec "$KRIO_BIN/profile-scripts" "$@" ;;
  macos-hacks|macos)       exec "$KRIO_BIN/macos-hacks" "$@" ;;

  # Management
  u|up|update|upgrade)     _krio_update ;;
  version|v|--version|-v)  _krio_version_info ;;
  release)                 _krio_release "$@" ;;
  h|help|--help|-h)        _krio_help ;;
  *)
    printf "kriogenx: unknown command '%s'\n\n" "$COMMAND" >&2
    _krio_help >&2
    exit 1
    ;;
esac
