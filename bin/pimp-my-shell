#!/usr/bin/env bash

KRIO_DIR="${KRIO_DIR:-$HOME/.kriogenx}"

# Pimp My Shell

if [[ ! -e ~/.oh-my-zsh ]]; then
  read -r -p "Install ZSH? y|n " install_zsh

  # Install OH MY ZSH
  if [[ $install_zsh = 'y' ]]; then
    curl -L https://github.com/robbyrussell/oh-my-zsh/raw/master/tools/install.sh | sh
  fi

else
  # Update ZSH
  (cd ~/.oh-my-zsh && git pull --rebase)
fi

if [[ -e ~/.oh-my-zsh ]]; then
  # Install Theme
  ln -sfn "$KRIO_DIR"/configs/kriogenx.zsh-theme ~/.oh-my-zsh/themes/kriogenx.zsh-theme
fi

# Share the idempotent profile setup with the package installer.
bash "$KRIO_DIR/bin/profile-scripts"

# TODO: Make sure zsh install properly
echo "ZSH has been installed!"
echo "Feel free to update your terminal command to:"
# TODO: use which zsh
echo "/bin/zsh"
echo "To start ZSH, run zsh"
