#!/usr/bin/env bash

# Create Link
# Create a link at the source to the destination

if [[ -z $1 ]]; then
  cat << EOF
Create Link
  Move source to destination and create sym link from source to destination
  If destination exists, add date to the old destination
usage:
  create_link [source] [destination]
EOF
  exit 0
fi

if [[ -z $2 ]]; then
  echo "create_link: destination is required" >&2
  exit 1
fi

S="$1"
D="$2"

[[ -n $3 ]] && DD="$3" || DD="$D-old-$(date "+%Y-%m-%d")"

# Source cannot already be a symlink
if [[ -L "$S" ]]; then
  echo "Error: Source is already a symlink:"
  echo "  $S"
  echo "Remove it manually if this is unexpected."
  exit 1
fi

# If destination is a symlink, remove it
if [[ -L "$D" ]]; then
  echo "Destination is a symlink. Removing it:"
  echo "  $D"
  rm -rf "$D"
fi

mkdir -p "$(dirname "$D")"

# Use sudo only when a parent directory we touch isn't writable
SUDO=()
for p in "$S" "$D" "$DD"; do
  [[ -w "$(dirname "$p")" ]] || SUDO=(sudo)
done
as_needed() { "${SUDO[@]}" "$@"; }

# Both directories exist
if [[ -d "$S" && -d "$D" ]]; then
  echo
  echo "Both source and destination directories exist:"
  echo "Source:      $S"
  echo "Destination: $D"
  echo
  echo "Choose an option:"
  echo "1) Merge source into destination with rsync"
  echo "2) Use source directory"
  echo "3) Use destination directory"
  read -r -p "Enter 1, 2, or 3: " choice

  case "$choice" in
    1)
      as_needed rsync -aEuv --progress --stats "$S/" "$D/"
      as_needed rm -rf "$S"
      ;;
    2)
      as_needed mv "$D" "$DD"
      as_needed mv "$S" "$D"
      ;;
    3)
      as_needed mv "$S" "$DD"
      ;;
    *)
      echo "Invalid choice. Aborting."
      exit 1
      ;;
  esac

# Source exists
elif [[ -e "$S" ]]; then
  if [[ -e "$D" ]]; then
    echo "Destination already exists. Moving source to duplicate:"
    echo "  $DD"
    as_needed mv "$S" "$DD"
  else
    as_needed mv "$S" "$D"
  fi

# Neither exists
elif [[ ! -e "$D" ]]; then
  echo "Neither location exists"
  echo "Source: $S"
  echo "Destination: $D"
  exit 0
fi

# Create symlink
as_needed ln -s "$D" "$S"

echo "Created symlink:"
echo "  $S -> $D"
