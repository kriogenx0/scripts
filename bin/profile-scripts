#!/usr/bin/env bash

KRIO_DIR="${KRIO_DIR:-$HOME/.kriogenx}"

# Keep profile setup safe to run repeatedly.
touch "$HOME/.profile"
profile_source="source \"$KRIO_DIR/configs/rc/bashrc\""
if ! grep -Fq "$KRIO_DIR/configs/rc/bashrc" "$HOME/.profile"; then
  printf '\n%s\n' "$profile_source" >> "$HOME/.profile"
fi

for rc_file in "$HOME/.zshrc" "$HOME/.bashrc" "$HOME/.bash_profile"; do
  if ! grep -Eq '^[[:space:]]*(source|\.)[[:space:]]+(~/\.profile|"?\$HOME/\.profile"?)[[:space:]]*$' "$rc_file" 2>/dev/null; then
    printf '\n%s\n' 'source ~/.profile' >> "$rc_file"
  fi
done
