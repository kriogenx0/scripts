#!/usr/bin/env bash

####################
# ALIASES
#
# Loads every topic file in configs/rc/aliases/, in a fixed order.
# Skip topics you don't use with, e.g.:
#   export KRIOGENX_SKIP_ALIASES="k8s ruby"
# Edit a topic (and reload it) with: aliasrc <topic>

# Locate this file in both bash and zsh (zsh syntax hidden from bash's parser)
if [ -n "$ZSH_VERSION" ]; then
  eval '_krio_aliasesrc=${(%):-%x}'
else
  _krio_aliasesrc=${BASH_SOURCE[0]}
fi
KRIOGENX_ALIASES_DIR="$(cd "$(dirname "$_krio_aliasesrc")" && pwd)/aliases"
unset _krio_aliasesrc

# Literal list: zsh doesn't word-split a $VAR in `for`. Keep both in sync.
# shellcheck disable=SC2034 # read by aliasrc in aliases/kriogenx.sh
KRIOGENX_ALIAS_TOPICS="core git apps python ruby node services docker k8s system kriogenx"

for _krio_topic in core git apps python ruby node services docker k8s system kriogenx; do
  case " ${KRIOGENX_SKIP_ALIASES:-} " in
    *" $_krio_topic "*) continue ;;
  esac
  # shellcheck source=/dev/null
  [ -f "$KRIOGENX_ALIASES_DIR/$_krio_topic.sh" ] && . "$KRIOGENX_ALIASES_DIR/$_krio_topic.sh"
done
unset _krio_topic
